<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSheetCustomerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetCustomerPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/accent"
        android:textSize="14sp" />

    <!-- Outcome Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/outcome_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgOutcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rbAnswered"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/outcome_answered"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbBusy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/outcome_busy"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbPostponed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/outcome_postponed"
            android:textColor="@color/text_primary" />

        <RadioButton
            android:id="@+id/rbOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/outcome_order"
            android:textColor="@color/success" />
    </RadioGroup>

    <!-- Notes Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/action_notes"
        app:boxStrokeColor="@color/primary_light"
        app:hintTextColor="@color/accent"
        android:textColorHint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCallNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="3"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Next Call Date Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/next_call_title"
        app:boxStrokeColor="@color/primary_light"
        app:hintTextColor="@color/accent"
        android:textColorHint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNextCallDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="غداً 11:00 AM"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveNotes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_save_notes"
            android:textColor="@color/white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCalendar"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:layout_marginStart="6dp"
            android:text="@string/btn_google_calendar"
            android:textColor="@color/accent"
            app:strokeColor="@color/accent"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>