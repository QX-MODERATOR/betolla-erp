# Betolla ERP — Environment Variables
#
# Copy this file to `.env.local` and fill in real values there.
# `.env.local` (and every other `.env*` variant) is already git-ignored — never commit real secrets.
#
# IMPORTANT: any variable prefixed NEXT_PUBLIC_ is bundled into client-side JavaScript
# and is visible to every visitor. Never put a real secret behind a NEXT_PUBLIC_ name.

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------

# Public project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose to the browser ONLY because Row Level
# Security policies (see supabase/migrations/005_auth_security_foundation.sql)
# restrict what it can read/write. Never substitute the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never log it, print it, or send it to the client.
# Used only by: lib/supabase/admin.ts, scripts/provision_users.mjs, Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Webhook security (public-facing intake endpoints)
# ---------------------------------------------------------------------------

# Shared secret required in the `X-Webhook-Secret` header for:
#   - POST /api/leads (Next.js)
#   - Supabase Edge Function: whatsapp-order
#   - Supabase Edge Function: ingest-lead
# Generate a long random value, e.g.: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=generate-a-long-random-value

# ---------------------------------------------------------------------------
# Telegram alert bot (optional — notifications are skipped if unset)
# ---------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-telegram-chat-id

# ---------------------------------------------------------------------------
# Google Calendar integration (optional)
# ---------------------------------------------------------------------------

GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
